@section('scripts')
<script>
  const datatable = Util.initDataTable('#primary_table', {
    columns: {
      id: {
        render: function(data) {
          return '<input class="checkbox checkbox-sm" type="checkbox" value="' + data + '" data-file-id="' + data + '" />';
        }
      },
      file_path: {
        render: function(item, data) {
          if (data.category === 'image') {
            return '<img src="' + item + '" alt="preview" class="w-16 h-16 object-cover rounded border border-gray-200" onerror="this.src=\'/assets/media/avatars/300-2.png\'">';
          }
          return '<i class="ki-filled ki-file text-3xl text-gray-400"></i>';
        }
      },
      file_name: {
        render: function(data) {
          return '<span class="text-sm font-medium">' + (data || '') + '</span>';
        }
      },
      category: {
        render: function(data) {
          const categoryNames = {
            'image': trans('image'),
            'document': trans('document'),
            'video': trans('video'),
            'audio': trans('audio'),
            'other': trans('other')
          };
          return '<span class="badge badge-sm badge-light">' + (categoryNames[data] || data) + '</span>';
        }
      },
      file_size_formatted: {
        render: function(data) {
          return '<span class="text-sm">' + (data || '-') + '</span>';
        }
      },
      uploader_name: {
        render: function(data) {
          return '<span class="text-sm">' + (data || '-') + '</span>';
        }
      },
      created_at: {
        render: function(data) {
          return '<span class="text-sm">' + (data || '-') + '</span>';
        }
      },
      action: {
        render: function(item, data) {
          let actions = '';
          if (data.category === 'image') {
            actions += '<button type="button" class="btn btn-sm btn-icon btn-light" onclick="previewImage(\'' + data.file_path + '\')" title="' + trans('preview') + '">' +
              '<i class="ki-filled ki-eye"></i>' +
              '</button>';
          }
          actions += '<a href="' + data.file_path + '" target="_blank" class="btn btn-sm btn-icon btn-light" title="' + trans('download') + '">' +
            '<i class="ki-filled ki-arrow-down"></i>' +
            '</a>';
          @if(hasPermission('/admin/files/list@remove'))
          actions += '<button type="button" class="btn btn-sm btn-icon btn-light" onclick="deleteFile(' + data.id + ')" title="' + trans('delete') + '">' +
            '<i class="ki-filled ki-trash"></i>' +
            '</button>';
          @endif
          return '<div class="flex gap-1">' + actions + '</div>';
        }
      }
    },
    apiEndpoint: '/api/files/get-list',
    pageSize: 20,
    initialPage: 1
  });

  // 选择文件后上传
  async function handleFileSelect(input) {
    if (!input.files || input.files.length === 0) return;

    const files = Array.from(input.files);
    await uploadFiles(files);
  }

  // 上传文件
  async function uploadFiles(files) {
    const progressDiv = document.getElementById('upload_progress');
    const progressBar = document.getElementById('progress_bar');
    const progressText = document.getElementById('progress_text');

    progressDiv.classList.remove('hidden');

    let uploadedCount = 0;
    const totalFiles = files.length;

    for (const file of files) {
      try {
        const formData = new FormData();
        formData.append('file', file);

        await axios.post('/api/files/upload', formData, {
          headers: {
            'Content-Type': 'multipart/form-data',
          },
        });

        uploadedCount++;
        const progress = Math.round((uploadedCount / totalFiles) * 100);
        progressBar.style.width = progress + '%';
        progressText.textContent = uploadedCount + '/' + totalFiles + ' - ' + progress + '%';
      } catch (error) {
        showError(file.name + ': ' + (error.response?.data?.msg || error.message));
      }
    }

    showSuccess(trans('upload') + ' ' + trans('success'));
    setTimeout(() => {
      progressDiv.classList.add('hidden');
      document.getElementById('file_input').value = '';
      loadFileList();
    }, 1000);
  }

  // 打开上传Modal
  function openUploadModal() {
    const modal = document.querySelector('#upload_modal');
    if (modal) {
      modal.classList.add('show');
    }
  }

  // 删除文件
  async function deleteFile(fileId) {
    if (!confirm(trans('confirm delete'))) return;

    try {
      const response = await axios.post('/api/files/remove', { file_id: fileId });
      if (response.data.code === 0) {
        showSuccess(trans('operation success'));
        loadFileList();
      } else {
        throw new Error(response.data.msg || trans('operation failed'));
      }
    } catch (error) {
      showError(error.message || trans('operation failed'));
    }
  }

  // 预览图片
  function previewImage(url) {
    window.open(url, '_blank');
  }

  // 加载文件列表
  function loadFileList() {
    const search = document.getElementById('search_input').value;
    const category = document.getElementById('category_select').value;

    if (datatable) {
      datatable.setParams({
        search: search,
        category: category
      });
      datatable.reload();
    }
  }

  // 重置筛选
  function resetFilter() {
    document.getElementById('search_input').value = '';
    document.getElementById('category_select').value = '';
    loadFileList();
  }

  // 批量删除
  document.getElementById('batch_delete_btn').addEventListener('click', async function() {
    const checked = document.querySelectorAll('#primary_table input[type="checkbox"]:checked:not([data-datatable-check="true"])');
    if (checked.length === 0) {
      showError(trans('please select files'));
      return;
    }

    const ids = Array.from(checked).map(function(cb) {
      return parseInt(cb.value);
    });
    const count = ids.length;

    if (!confirm(trans('confirm delete these items').replace('[[0]]', count))) return;

    try {
      const response = await axios.post('/api/files/batch-remove', { ids: ids });
      if (response.data.code === 0) {
        showSuccess(trans('operation success'));
        loadFileList();
        this.disabled = true;
      } else {
        throw new Error(response.data.msg || trans('operation failed'));
      }
    } catch (error) {
      showError(error.message || trans('operation failed'));
    }
  });

  // 监听复选框变化，控制批量删除按钮状态
  document.addEventListener('change', function(e) {
    if (e.target.type === 'checkbox' && e.target.closest('#primary_table')) {
      const checked = document.querySelectorAll('#primary_table input[type="checkbox"]:checked:not([data-datatable-check="true"])');
      document.getElementById('batch_delete_btn').disabled = checked.length === 0;
    }
  });
</script>
@endsection

