<!-- 脚本 -->
@section('scripts')
<script>
  // 格式化文件大小
  function formatFileSize(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
  }

  // 获取活动图标
  function getActivityIcon(type) {
    const icons = {
      'member': 'ki-filled ki-profile-user',
      'file': 'ki-filled ki-file',
      'notice': 'ki-filled ki-notification'
    };
    return icons[type] || 'ki-filled ki-information-5';
  }

  // 获取活动颜色
  function getActivityColor(type) {
    const colors = {
      'member': 'primary',
      'file': 'success',
      'notice': 'warning'
    };
    return colors[type] || 'gray';
  }

  // 加载统计数据
  async function loadStatistics() {
    try {
      const response = await axios.post('/api/dashboard/get-statistics');
      if (response.data.code === 0) {
        const data = response.data.data;
        
        // 会员统计
        document.getElementById('stat_member_total').textContent = data.member.total || 0;
        document.getElementById('stat_member_today').textContent = data.member.today_new || 0;
        
        // 文件统计
        document.getElementById('stat_file_total').textContent = data.file.total || 0;
        document.getElementById('stat_file_today').textContent = data.file.today_new || 0;
        document.getElementById('stat_file_image').textContent = data.file.by_category.image || 0;
        document.getElementById('stat_file_document').textContent = data.file.by_category.document || 0;
        document.getElementById('stat_file_video').textContent = data.file.by_category.video || 0;
        document.getElementById('stat_file_audio').textContent = data.file.by_category.audio || 0;
        document.getElementById('stat_file_other').textContent = data.file.by_category.other || 0;
        document.getElementById('stat_file_storage').textContent = formatFileSize(data.file.total_size || 0);
        
        // 公告统计
        document.getElementById('stat_notice_total').textContent = data.notice.total || 0;
        document.getElementById('stat_notice_published').textContent = data.notice.published || 0;
        
        // 角色统计
        document.getElementById('stat_role_total').textContent = data.role.role_total || 0;
        document.getElementById('stat_permission_total').textContent = data.role.permission_total || 0;
        
        // 最近活动
        renderRecentActivities(data.recent_activities || []);
      } else {
        throw new Error(response.data.msg || trans('load failed'));
      }
    } catch (error) {
      console.error('加载统计数据失败:', error);
      showError(error.message || trans('load failed'));
    }
  }

  // 渲染最近活动
  function renderRecentActivities(activities) {
    const container = document.getElementById('recent_activities_list');
    
    if (!activities || activities.length === 0) {
      container.innerHTML = '<div class="text-center text-gray-500 py-4">' + trans('no_data') + '</div>';
      return;
    }
    
    let html = '';
    activities.forEach(function(activity) {
      const icon = getActivityIcon(activity.type);
      const color = getActivityColor(activity.type);
      html += '<div class="flex items-start gap-3">' +
        '<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-' + color + ' bg-opacity-10 shrink-0">' +
        '<i class="' + icon + ' text-' + color + ' text-sm"></i>' +
        '</div>' +
        '<div class="flex flex-col gap-1 flex-1 min-w-0">' +
        '<span class="text-sm font-medium text-gray-900">' + (activity.title || '') + '</span>' +
        '<span class="text-xs text-gray-600 truncate">' + (activity.content || '') + '</span>' +
        '<span class="text-xs text-gray-500">' + (activity.time || '') + '</span>' +
        '</div>' +
        '</div>';
    });
    
    container.innerHTML = html;
  }

  // 页面加载时获取统计数据
  document.addEventListener('DOMContentLoaded', function() {
    loadStatistics();
  });
</script>
@endsection
