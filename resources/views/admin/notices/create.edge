@section('scripts')
<script>
  let isSubmitting = false;

  // 表单提交
  document.getElementById('create_form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    if (isSubmitting) return;

    const submitBtn = document.getElementById('submit_btn');
    const indicatorLabel = submitBtn.querySelector('.indicator-label');
    const indicatorProgress = submitBtn.querySelector('.indicator-progress');

    try {
      indicatorLabel.classList.add('hidden');
      indicatorProgress.classList.remove('hidden');
      submitBtn.disabled = true;
      isSubmitting = true;

      const formData = {
        title: document.getElementById('title').value,
        content: document.getElementById('content').value,
        type: document.getElementById('type').value,
        status: document.getElementById('status').value,
        is_top: document.getElementById('is_top').value,
        publish_time: document.getElementById('publish_time').value || new Date().toISOString().slice(0, 16).replace('T', ' '),
        expire_time: document.getElementById('expire_time').value || null,
      };

      // 格式化日期时间
      if (formData.publish_time) {
        formData.publish_time = formData.publish_time.replace('T', ' ') + ':00';
      }
      if (formData.expire_time) {
        formData.expire_time = formData.expire_time.replace('T', ' ') + ':00';
      }

      const response = await axios.post('/api/notices/create-info', formData);

      if (response.data.code === 0) {
        showSuccess(trans('operation success'), {
          autoClose: 1500,
          onConfirm: () => {
            window.location.href = '/admin/notices/list';
          }
        });
      } else {
        throw new Error(response.data.msg || trans('operation failed'));
      }
    } catch (error) {
      showError(error.message || trans('operation failed'));
    } finally {
      indicatorLabel.classList.remove('hidden');
      indicatorProgress.classList.add('hidden');
      submitBtn.disabled = false;
      isSubmitting = false;
    }
  });

  // 设置默认发布时间为当前时间
  const now = new Date();
  const localDateTime = now.toISOString().slice(0, 16);
  document.getElementById('publish_time').value = localDateTime;
</script>
@endsection

