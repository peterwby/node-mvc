@section('scripts')
<script>
  let datatable;

  // 初始化数据表格
  datatable = Util.initDataTable('#primary_table', {
    apiEndpoint: '/api/notices/get-list',
    pageSize: 20,
    initialPage: 1,
    columns: {
      id: {
        render: (item) => {
          return '<input class="checkbox checkbox-sm" data-datatable-row-check="true" type="checkbox" value="' + item + '">'
        },
      },
      title: {
        render: (item) => {
          return '<div class="font-medium">' + (item || trans('no data')) + '</div>'
        },
      },
      type: {
        render: (item) => {
          const typeMap = {
            'info': '<span class="badge badge-light-primary">' + trans('info') + '</span>',
            'warning': '<span class="badge badge-light-warning">' + trans('warning') + '</span>',
            'success': '<span class="badge badge-light-success">' + trans('success') + '</span>',
            'error': '<span class="badge badge-light-danger">' + trans('error') + '</span>',
          }
          return typeMap[item] || '<span class="badge">' + (item || trans('no data')) + '</span>'
        },
      },
      status: {
        render: (item) => {
          return item == 1 
            ? '<span class="badge badge-light-success">' + trans('published') + '</span>'
            : '<span class="badge badge-light-secondary">' + trans('unpublished') + '</span>'
        },
      },
      is_top: {
        render: (item) => {
          return item == 1 
            ? '<span class="badge badge-light-primary">' + trans('yes') + '</span>'
            : '<span class="badge">' + trans('no') + '</span>'
        },
      },
      publisher_name: {
        render: (item) => {
          return '<div>' + (item || trans('no data')) + '</div>'
        },
      },
      publish_time: {
        render: (item) => {
          return '<div>' + (item || trans('no data')) + '</div>'
        },
      },
      expire_time: {
        render: (item) => {
          return '<div>' + (item || trans('no data')) + '</div>'
        },
      },
      action: {
        render: (item, data) => {
          return '<div class="menu flex-inline" data-menu="true">' +
            '<div class="menu-item" data-menu-item-offset="0, 10px" data-menu-item-placement="bottom-end">' +
            '<button class="menu-toggle btn btn-sm btn-icon btn-light btn-clear">' +
            '<i class="ki-filled ki-dots-vertical"></i>' +
            '</button>' +
            '<div class="menu-dropdown menu-default w-full max-w-[120px]" data-menu-dismiss="true">' +
            (hasPermission('/admin/notices/list@edit') ?
            '<div class="menu-item">' +
            '<a class="menu-link" href="/admin/notices/edit/' + data.id + '">' +
            '<span class="menu-title">' + trans('edit') + '</span>' +
            '</a>' +
            '</div>' : '') +
            '<div class="menu-separator"></div>' +
            (hasPermission('/admin/notices/list@remove') ?
            '<div class="menu-item">' +
            '<button type="button" class="menu-link remove-btn" data-id="' + data.id + '">' +
            '<span class="menu-title">' + trans('delete') + '</span>' +
            '</button>' +
            '</div>' : '') +
            '</div>' +
            '</div>' +
            '</div>'
        },
      },
    }
  })

  // 处理单行删除
  Util.handleRowDelete({
    tableId: '#primary_table',
    deleteApi: '/api/notices/remove',
    onSuccess: () => {
      datatable.reload()
    }
  })

  // 批量删除
  document.getElementById('batch_delete_btn').addEventListener('click', async function() {
    const checked = document.querySelectorAll('#primary_table input[type="checkbox"]:checked:not([data-datatable-check="true"])');
    if (checked.length === 0) {
      showError(trans('please select items'));
      return;
    }
    
    const ids = Array.from(checked).map(cb => parseInt(cb.value));
    const count = ids.length;
    
    if (!confirm(trans('confirm delete these items').replace('[[0]]', count))) return;
    
    try {
      const response = await axios.post('/api/notices/remove', { ids: ids });
      if (response.data.code === 0) {
        showSuccess(trans('operation success'));
        datatable.reload();
        this.disabled = true;
      } else {
        throw new Error(response.data.msg || trans('operation failed'));
      }
    } catch (error) {
      showError(error.message || trans('operation failed'));
    }
  });

  // 监听复选框变化
  document.addEventListener('change', function(e) {
    if (e.target.type === 'checkbox' && e.target.closest('#primary_table')) {
      const checked = document.querySelectorAll('#primary_table input[type="checkbox"]:checked:not([data-datatable-check="true"])');
      document.getElementById('batch_delete_btn').disabled = checked.length === 0;
    }
  });

  // 加载列表
  function loadNoticeList() {
    const search = document.getElementById('search_input').value;
    const status = document.getElementById('status_select').value;
    const is_top = document.getElementById('is_top_select').value;
    
    datatable.setParams({
      search: search,
      status: status,
      is_top: is_top,
    });
    datatable.reload();
  }

  // 重置筛选
  function resetFilter() {
    document.getElementById('search_input').value = '';
    document.getElementById('status_select').value = '';
    document.getElementById('is_top_select').value = '';
    loadNoticeList();
  }

  // 初始化筛选
  loadNoticeList();
</script>
@endsection

