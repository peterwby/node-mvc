                  <div class="flex flex-col gap-1.5">
                    <input type="file" id="avatar_file" name="avatar_file" accept="image/*" class="hidden" onchange="handleAvatarUpload(this)">
                    <button type="button" class="btn btn-sm btn-primary" onclick="document.getElementById('avatar_file').click()">
