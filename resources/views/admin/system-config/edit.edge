@section('scripts')
<script>
  let isSubmitting = false;

  // 初始化标签页切换
  document.addEventListener('DOMContentLoaded', function() {
    // 维护模式开关状态更新
    const maintenanceModeSwitch = document.getElementById('maintenance_mode');
    const maintenanceModeStatus = document.getElementById('maintenance_mode_status');
    
    if (maintenanceModeSwitch) {
      maintenanceModeSwitch.addEventListener('change', function() {
        maintenanceModeStatus.textContent = this.checked ? trans('enabled') : trans('disabled');
      });
    }
  });

  /**
   * 处理Logo上传
   */
  async function handleLogoUpload(input) {
    if (!input.files || !input.files[0]) return;

    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);

    try {
      const response = await axios.post('/api/system-config/upload-logo', formData, {
        headers: {
          'Content-Type': 'multipart/form-data',
        },
      });

      if (response.data.code === 0) {
        const logoUrl = response.data.data.url;
        document.getElementById('logo_url').value = logoUrl;
        document.getElementById('logo_preview').src = logoUrl;
        showSuccess(trans('upload') + ' ' + trans('success'));
      } else {
        throw new Error(response.data.msg || trans('upload') + ' ' + trans('failed'));
      }
    } catch (error) {
      showError(error.message || trans('upload') + ' ' + trans('failed'));
      input.value = '';
    }
  }

  /**
   * 处理登录页背景图上传
   */
  async function handleLoginBgUpload(input, mode) {
    if (!input.files || !input.files[0]) return;

    const file = input.files[0];
    const formData = new FormData();
    formData.append('file', file);
    formData.append('mode', mode);

    try {
      const response = await axios.post('/api/system-config/upload-login-bg', formData, {
        headers: {
          'Content-Type': 'multipart/form-data',
        },
      });

      if (response.data.code === 0) {
        const bgUrl = response.data.data.url;
        const configKey = mode === 'dark' ? 'login_bg_image_dark' : 'login_bg_image';
        document.getElementById(configKey).value = bgUrl;
        document.getElementById(mode === 'dark' ? 'login_bg_dark_preview' : 'login_bg_light_preview').src = bgUrl;
        showSuccess(trans('upload') + ' ' + trans('success'));
      } else {
        throw new Error(response.data.msg || trans('upload') + ' ' + trans('failed'));
      }
    } catch (error) {
      showError(error.message || trans('upload') + ' ' + trans('failed'));
      input.value = '';
    }
  }

  /**
   * 保存所有配置
   */
  async function saveAllConfigs() {
    if (isSubmitting) return;

    const submitBtn = document.getElementById('submit_btn');
    const indicatorLabel = submitBtn.querySelector('.indicator-label');
    const indicatorProgress = submitBtn.querySelector('.indicator-progress');

    try {
      // 显示加载状态
      indicatorLabel.classList.add('hidden');
      indicatorProgress.classList.remove('hidden');
      submitBtn.disabled = true;
      isSubmitting = true;

      // 收集表单数据
      const configs = {
        system_name: document.getElementById('system_name').value,
        system_description: document.getElementById('system_description').value,
        logo_url: document.getElementById('logo_url').value,
        footer_year: document.getElementById('footer_year').value,
        footer_company_name: document.getElementById('footer_company_name').value,
        footer_company_url: document.getElementById('footer_company_url').value,
        login_bg_image: document.getElementById('login_bg_image').value,
        login_bg_image_dark: document.getElementById('login_bg_image_dark').value,
        upload_max_size: document.getElementById('upload_max_size').value,
        maintenance_mode: document.getElementById('maintenance_mode').checked ? '1' : '0',
        maintenance_message: document.getElementById('maintenance_message').value,
      };

      const response = await axios.post('/api/system-config/batch-update', {
        configs: configs,
      });

      if (response.data.code === 0) {
        showSuccess(trans('operation success'), {
          autoClose: 1500,
          onConfirm: () => {
            window.location.reload();
          }
        });
      } else {
        throw new Error(response.data.msg || trans('operation failed'));
      }
    } catch (error) {
      showError(error.message || trans('operation failed'));
    } finally {
      // 恢复按钮状态
      indicatorLabel.classList.remove('hidden');
      indicatorProgress.classList.add('hidden');
      submitBtn.disabled = false;
      isSubmitting = false;
    }
  }
</script>
@endsection

